ENV=development

# SQLite by default; swap for Postgres/MySQL in production, e.g.:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/exam_allocation
DATABASE_URL=sqlite:///./exam_allocation.db

SECRET_KEY=please-change-this-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Comma-separated frontend origin(s) allowed to call this API, e.g.
# https://your-app.vercel.app,http://localhost:5173
ALLOWED_ORIGINS=*

DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@mapoly.edu.ng
DEFAULT_ADMIN_PASSWORD=ChangeMe123!
